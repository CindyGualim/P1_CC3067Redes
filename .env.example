# Google AI Studio key for the Gemini host (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# DEBUG dumps every JSON-RPC frame to logs/app.log
LOG_LEVEL=INFO

# Seconds before an MCP request is cancelled
MCP_REQUEST_TIMEOUT=60

# Remote Pharmacy MCP server. Enable pharmacy_remote in config/servers.json
# after deploying it, and disable the local pharmacy entry for a remote-only demo.
PHARMACY_REMOTE_URL=https://your-cloud-run-service.run.app/mcp
MCP_AUTH_TOKEN=replace-with-a-long-random-token
