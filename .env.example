# Google AI Studio key for the Gemini host (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
# gemini-2.5-flash responde en ~1s, suficiente para elegir herramientas.
# Cambie a gemini-2.5-pro si necesita razonamiento mas profundo.
GEMINI_MODEL=gemini-2.5-flash

# DEBUG dumps every JSON-RPC frame to logs/app.log
LOG_LEVEL=INFO

# Seconds before an MCP request is cancelled
MCP_REQUEST_TIMEOUT=60
